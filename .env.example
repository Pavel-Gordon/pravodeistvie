# Доставка заявок с формы обратной связи.
# Достаточно настроить ОДИН из вариантов.

# ── Вариант A (рекомендуется): Formspree ───────────────────────────────
# Заявки приходят на email. Секретов не требуется, безопасно для GitHub Pages.
# Получите endpoint на https://formspree.io (New form -> email), напр.:
# VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/xxxxxxxx
VITE_FORMSPREE_ENDPOINT=

# ── Вариант B: Telegram Bot API ────────────────────────────────────────
# Заявки приходят в чат Telegram.
# ВНИМАНИЕ: токен бота попадает в клиентский бандл и виден любому, кто откроет
# исходники сайта. Используйте отдельного бота и принимайте риск спама,
# либо проксируйте запрос через серверless-функцию.
VITE_TELEGRAM_BOT_TOKEN=
VITE_TELEGRAM_CHAT_ID=
